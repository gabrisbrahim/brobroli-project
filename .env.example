# =====================================================================
# BROBROLI — CONFIGURATION OFFICIELLE DES PAIEMENTS CÔTE D'IVOIRE
# =====================================================================

# Port local ou fourni par Hostinger (ne pas modifier sur Hostinger)
PORT=5000

# URL publique de votre application en ligne (ex: https://brobroli.ci ou sous-domaine Hostinger)
APP_URL=https://votre-app.hostingerapp.com

# ---------------------------------------------------------------------
# 1. CINETPAY CÔTE D'IVOIRE (Orange Money, MTN MoMo, Moov Money, Carte)
#    Obtenez vos identifiants marchands sur https://cinetpay.com
# ---------------------------------------------------------------------
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=

# ---------------------------------------------------------------------
# 2. WAVE BUSINESS CÔTE D'IVOIRE
#    Obtenez vos clés sur https://www.wave.com/fr/business/
# ---------------------------------------------------------------------
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
